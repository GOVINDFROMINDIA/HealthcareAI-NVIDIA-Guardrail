tion = None\n","\n","# Define model and tokenizer with memory-efficient settings\n","base_model_id = \"mistralai/Mistral-7B-v0.1\"\n","bnb_config = BitsAndBytesConfig(\n","    load_in_4bit=True,  # Memory optimization\n","    bnb_4bit_use_double_quant=True,\n","    bnb_4bit_quant_type=\"nf4\",\n","    bnb_4bit_compute_dtype=torch.bfloat16\n",")\n","\n","model = AutoModelForCausalLM.from_pretrained(base_model_id, quantization_config=bnb_config)\n","tokenizer = AutoTokenizer.from_pretrained(base_model_id, model_max_length=512, add_eos_token=True)\n","tokenizer.pad_token = tokenizer.eos_token\n","\n","# Load fine-tuned model with optimized memory\n","ft_model = PeftModel.from_pretrained(model, \"/content/drive/MyDrive/GUARDRAIL/Model/Mistral/Model1/Checkpoint2\")\n","ft_model.eval()\n","\n","device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n","ft_model = ft_model.to(device)\n","\n","# Dynamic sampling parameters based on user input complexity\n","def adjust_sampling_params(user_input):\n","    if len(user_input) < 20:\n","        return 0.5, 0.8\n","    elif len(user_input) < 50:\n","        return 0.7, 0.9\n","    else:\n","        return 0.8, 0.95\n","\n","# Pre-tokenization cache\n","tokenized_cache = {}\n","\n","def cached_tokenize(prompt):\n","    if prompt in tokenized_cache:\n","        return tokenized_cache[prompt]\n","    else:\n","        tokenized_prompt = tokenizer(prompt, return_tensors=\"pt\").to(device)\n","        tokenized_cache[prompt] = tokenized_prompt\n","        return tokenized_prompt\n","\n","# Stopping criteria for end of sentence\n","class EndOfSentenceStoppingCriteria(StoppingCriteria):\n","    def __init__(self, tokenizer, eos_tokens):\n","        self.tokenizer = tokenizer\n","        self.eos_tokens = eos_tokens\n","\n","    def __call__(self, input_ids, scores, **kwargs):\n","        decoded = self.tokenizer.decode(input_ids[0][-1:])\n","        return any(token in decoded for token in self.eos_tokens)\n","\n","eos_tokens = ['.', '!', '?']\n","stopping_criteria = StoppingCriteriaList([EndOfSentenceStoppingCriteria(tokenizer, eos_tokens)])\n","\n","# Batch inference for multiple user inputs\n","def generate_batch(prompts):\n","    inputs = tokenizer(prompts, return_tensors=\"pt\", padding=True, truncation=True, max_length=512).to(device)\n","    with torch.no_grad():\n","        outputs = ft_model.generate(\n","            **inputs,\n","            max_new_tokens=256,\n","            do_sample=True,\n","            temperature=0.7,\n","            top_p=0.9,\n","            pad_token_id=tokenizer.eos_token_id,\n","            repetition_penalty=1.2,\n","            stopping_criteria=stopping_criteria\n","        )\n","    responses = [tokenizer.decode(output, skip_special_tokens=True) for output in outputs]\n","    return responses\n","\n","# Define a custom LLM for NeMo Guardrails\n","class CustomLLM(LLM):\n","    model: Any\n","    tokenizer: Any\n","\n","    def __init__(self, model, tokenizer):\n","        super().__init__()\n","        self.model = model\n","        self.tokenizer = tokenizer\n","\n","    @property\n","    def _llm_type(self) -> str:\n","        return \"custom\"\n","\n","    def _call(self, prompt: str, stop: Optional[List[str]] = None, run_manager: Optional[CallbackManagerForLLMRun] = None, **kwargs: Any) -> str:\n","        inputs = cached_tokenize(prompt)\n","        with torch.no_grad():\n","            outputs = self.model.generate(\n","                **inputs,\n","                max_new_tokens=256,\n","                do_sample=True,\n","                temperature=0.7,\n","                top_p=0.9,\n","                pad_token_id=self.tokenizer.eos_token_id,\n","                repetition_penalty=1.2,\n","                stopping_criteria=stopping_criteria\n","            )\n","        return self.tokenizer.decode(outputs[0][len(inputs.input_ids[0]):], skip_special_tokens=True)\n","\n","# Create an instance of the custom LLM\n","custom_llm = CustomLLM(ft_model, tokenizer)\n","\n","# NeMo Guardrails configuration for safe interactions\n","config = RailsConfig.from_content(\n","    \"\"\"\n","    define user express intent politely\n","        \"The user expresses their intent in a polite manner.\"\n","\n","    define bot respond politely\n","        \"The bot responds in a polite and helpful manner.\"\n","\n","    define user ask unsafe question\n","        \"The user asks a question about harmful or illegal activities.\"\n","\n","    define bot refuse unsafe\n","        \"The bot politely refuses to answer questions about harmful or illegal activities.\"\n","\n","    define bot suggest safe activity\n","        \"The bot suggests an alternative safe activity or response.\"\n","\n","    define flow polite interaction\n","        user express intent politely\n","        bot respond politely\n","\n","    define flow unsafe question handling\n","        user ask unsafe question\n","        bot refuse unsafe\n","        bot suggest safe activity\n","    \"\"\"\n",")\n","\n","# Initialize NeMo Guardrails with custom LLM\n","rails = LLMRails(config, llm=custom_llm)\n","\n","# Async chat loop with NeMo Guardrails\n","async def chat():\n","    while True:\n","        user_input = input(\"You: \")\n","\n","        if user_input.upper() == \"QUIT\":\n","            print(\"Exiting the chat.\")\n","            break\n","\n","        temperature, top_p = adjust_sampling_params(user_input)\n","\n","        bot_message = await rails.generate_async(messages=[{\"role\": \"user\", \"content\": user_input}])\n","        print(f\"Model: {bot_message['content']}\")\n","\n","# Run the chat loop\n","asyncio.run(chat())\n"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":690,"referenced_widgets":["5dfe4ccaefdc4e55873b0e85caf34a03","d97019fed0fd47ed99c4acae5daa752a","1f442e18fc77463abfb564b934c623b7","927fcb7ea808408da914cd0a51e2d479","547b093f4cf74504803ed0f657d4c